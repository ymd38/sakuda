# Required. base64 of 32 random bytes: `pnpm keygen`
SAKUDA_ENCRYPTION_KEY=
SAKUDA_DATA_DIR=./data
SAKUDA_NUCLEI_BIN=nuclei
SAKUDA_NUCLEI_TEMPLATES=/opt/nuclei-templates/http
SAKUDA_NUCLEI_MAX_MINUTES=60
# ZAP command. Dev on macOS: ./scripts/zap-docker.sh ; in the image: /zap/zap.sh
SAKUDA_ZAP_CMD=zap.sh
# Set when ZAP sees the scan work dir at a different path (dev wrapper mounts it at /zap/wrk)
SAKUDA_ZAP_WORKDIR=
SAKUDA_ZAP_MAX_HEAP=1024m
# Rewrite localhost/127.0.0.1 in target URLs (needed inside Docker). Dev: leave empty; ZAP-only alias below.
SAKUDA_LOCALHOST_ALIAS=
SAKUDA_ZAP_LOCALHOST_ALIAS=host.docker.internal
SAKUDA_ENGINE_GRACE_MINUTES=10
SAKUDA_JOB_RUNNER=on
LOG_LEVEL=info
